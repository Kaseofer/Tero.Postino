<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire hosting integrations (AppHost) -->
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Seq" Version="13.4.6" />

    <!-- Web API (webapi with controllers template) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc" Version="10.0.11" />

    <!-- Consola interactiva sobre el documento OpenAPI, sólo en Development. Desde .NET 9
         la plantilla ya no trae interfaz: AddOpenApi genera el JSON y nada más. -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.20" />

    <!-- Persistencia (Tero.Auth.Infrastructure). Relational se referencia explícito (no
         privado) para fijar su versión en 10.0.11 en todo el grafo: Npgsql.EntityFrameworkCore.
         PostgreSQL 10.0.3 sólo pide [10.0.4, 11.0.0), y sin este piso el proyecto de tests
         (que no ve las dependencias privadas de Design) resolvía 10.0.4 y colisionaba con el
         10.0.11 que arrastra la cadena de ProjectReference. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />

    <!-- Autenticación. Api usa el JwtBearer de ASP.NET Core (valida). Infrastructure emite
         tokens con las librerías IdentityModel puras (sin ASP.NET Core) y hashea con
         Identity.Core; ninguna de las dos es "automática" ahí porque Infrastructure es una
         librería de clases (Sdk="Microsoft.NET.Sdk"), no un proyecto Web. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.11" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />

    <!-- aspire-servicedefaults template -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.6.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />

    <!-- RabbitMQ Client -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />

    <!-- Tero.Shared (GitHub Packages) -->
    <PackageVersion Include="Tero.Contracts" Version="0.6.0" />
    <PackageVersion Include="Tero.Messaging" Version="0.6.0" />
    <PackageVersion Include="Tero.Persistence" Version="0.6.0" />
    <PackageVersion Include="Tero.ServiceDefaults" Version="0.6.0" />

    <!-- HttpContext abstractions para Application layer -->
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.2.0" />
  </ItemGroup>

</Project>
