<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Tero.Contracts" />
    <!-- POST-01: AuthServiceTokenClient, AppointmentsReminderClient y WhatsAppGatewayClient
         necesitan IHttpClientFactory. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Domain llega transitivamente vía Application. -->
    <ProjectReference Include="..\Tero.Postino.Application\Tero.Postino.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plantillas de mail (MailTemplateRenderer) — viajan con el deploy, editables como
         HTML común sin levantar nada. -->
    <Content Include="Templates\**\*.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
