<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Tero.Contracts" />
    <!-- IServiceTokenProvider vive en Tero.ServiceDefaults (backlog de Tero.Shared, SH-P1-1) —
         lo consumen AuthenticatedHttpClientBase, AppointmentsReminderClient y
         WhatsAppGatewayClient. -->
    <PackageReference Include="Tero.ServiceDefaults" />
    <!-- POST-01: AppointmentsReminderClient y WhatsAppGatewayClient necesitan
         IHttpClientFactory. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Domain llega transitivamente vía Application. -->
    <ProjectReference Include="..\Tero.Postino.Application\Tero.Postino.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plantillas de mail (MailTemplateRenderer) — viajan con el deploy, editables como
         HTML/texto común sin levantar nada. *.subject.txt: asunto por tipo+idioma (BACKLOG.md #1). -->
    <Content Include="Templates\**\*.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Templates\**\*.subject.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
